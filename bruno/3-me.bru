meta {
  name: Me
  type: http
  seq: 3
}

get {
  url: {{baseUrl}}/api/users/me
  body: none
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

tests {
  test("authenticated user", function () {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody().item.email).to.equal(bru.getVar("email"));
  });
}
